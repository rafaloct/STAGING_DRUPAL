<?php

/**
 * @file
 * Theme hooks for NERUDS territorial portal components.
 */

/**
 * Implements hook_theme().
 */
function neruds_google_integration_theme(): array {
  return [
    'neruds_territory_map' => [
      'variables' => [
        'title' => NULL,
        'summary' => NULL,
      ],
    ],
    'neruds_live_dashboard' => [
      'variables' => [
        'title' => NULL,
        'metrics' => [],
      ],
    ],
    'neruds_territorial_timeline' => [
      'variables' => [
        'title' => NULL,
      ],
    ],
    'neruds_publication_discovery' => [
      'variables' => [
        'title' => NULL,
      ],
    ],
    'neruds_dataset_discovery' => [
      'variables' => [
        'title' => NULL,
      ],
    ],
    'neruds_audit_widget' => [
      'variables' => [
        'audit_id' => NULL,
      ],
    ],
  ];
}

/**
 * Implements hook_library_info_alter().
 */
function neruds_google_integration_library_info_alter(array &$libraries, string $extension): void {
  if ($extension !== 'ai_image_alt_text' || empty($libraries['alt_text'])) {
    return;
  }

  $module_path = \Drupal::service('extension.list.module')->getPath('neruds_google_integration');
  $libraries['alt_text']['js']['/' . $module_path . '/js/ai-alt-text-fix.js'] = [];
}

/**
 * Implements hook_page_attachments().
 */
function neruds_google_integration_page_attachments(array &$attachments): void {
  $attachments['#attached']['library'][] = 'neruds_google_integration/accessibility_preferences';
  $attachments['#attached']['drupalSettings']['nerudsAccessibility'] = [
    'vlibrasEnabled' => _neruds_google_integration_vlibras_enabled(),
  ];

  $measurement_id = _neruds_google_integration_ga4_measurement_id();
  if ($measurement_id === '') {
    return;
  }

  $attachments['#attached']['html_head'][] = [
    [
      '#tag' => 'script',
      '#attributes' => [
        'async' => 'async',
        'src' => 'https://www.googletagmanager.com/gtag/js?id=' . rawurlencode($measurement_id),
      ],
    ],
    'neruds_google_integration_gtag_src',
  ];
  $attachments['#attached']['html_head'][] = [
    [
      '#tag' => 'script',
      '#value' => "window.dataLayer = window.dataLayer || [];\nfunction gtag(){dataLayer.push(arguments);}\ngtag('js', new Date());\ngtag('config', '" . addslashes($measurement_id) . "', { anonymize_ip: true });",
    ],
    'neruds_google_integration_gtag_config',
  ];
}

function _neruds_google_integration_vlibras_enabled(): bool {
  $value = getenv('NERUDS_ENABLE_VLIBRAS');
  return !($value === '0' || $value === 'false' || $value === 'no' || $value === 'off');
}

function _neruds_google_integration_ga4_measurement_id(): string {
  $environment = _neruds_google_integration_environment();
  if ($environment === 'stag') {
    $stag = _neruds_google_integration_env_or_config('NERUDS_GA4_MEASUREMENT_ID_STAG', 'ga4_measurement_id_stag');
    if ($stag !== '') return $stag;
  }
  $prod = _neruds_google_integration_env_or_config('NERUDS_GA4_MEASUREMENT_ID_PROD', 'ga4_measurement_id_prod');
  return $prod !== '' ? $prod : _neruds_google_integration_env_or_config('NERUDS_GA4_MEASUREMENT_ID', 'ga4_measurement_id');
}

function _neruds_google_integration_env_or_config(string $env_name, string $config_name): string {
  $value = getenv($env_name);
  if (is_string($value) && $value !== '') return $value;
  return (string) (\Drupal::config('neruds_google_integration.settings')->get($config_name) ?: '');
}

function _neruds_google_integration_environment(): string {
  $explicit = getenv('NERUDS_ENVIRONMENT');
  if (is_string($explicit) && in_array($explicit, ['prod', 'production', 'stag', 'staging', 'homolog'], TRUE)) {
    return in_array($explicit, ['prod', 'production'], TRUE) ? 'prod' : 'stag';
  }
  $host = $_SERVER['HTTP_HOST'] ?? '';
  return (str_contains($host, 'homolog') || str_contains($host, 'staging')) ? 'stag' : 'prod';
}

function neruds_google_integration_preprocess_node(array &$variables): void {
  $node = $variables['node'] ?? NULL;
  if (!$node instanceof \Drupal\node\NodeInterface) {
    return;
  }

  if ($node->bundle() === 'grupo_estudos') {
    $variables['#attached']['library'][] = 'neruds_google_integration/google_drive_documents';
    $variables['#attached']['library'][] = 'neruds_google_integration/research_communities';

    if ($node->hasField('field_drive_folder_url') && !$node->get('field_drive_folder_url')->isEmpty()) {
      $variables['neruds_group_drive_url'] = $node->get('field_drive_folder_url')->value;
    }
    return;
  }

  if ($node->bundle() === 'noticia') {
    $variables['#attached']['library'][] = 'neruds_google_integration/territorial_news';
  }
}

/**
 * Implements hook_entity_insert().
 */
function neruds_google_integration_entity_insert(\Drupal\Core\Entity\EntityInterface $entity): void {
  if (!$entity instanceof \Drupal\node\NodeInterface) {
    return;
  }

  $bundle = $entity->bundle();

  if (!in_array($bundle, ['publicacao', 'publicacao_cientifica', 'projeto_pesquisa_extensao', 'evento_cientifico'], TRUE)) {
    return;
  }

  \Drupal::queue('neruds_google_sync')->createItem([
    'action' => 'insert',
    'entity_type' => $entity->getEntityTypeId(),
    'entity_id' => $entity->id(),
    'bundle' => $bundle,
    'timestamp' => \Drupal::time()->getRequestTime(),
  ]);

  \Drupal::logger('neruds_google_integration')
    ->info('Queued sync for @bundle @id', ['@bundle' => $bundle, '@id' => $entity->id()]);
}

/**
 * Implements hook_entity_update().
 */
function neruds_google_integration_entity_update(\Drupal\Core\Entity\EntityInterface $entity): void {
  if (!$entity instanceof \Drupal\node\NodeInterface) {
    return;
  }

  $bundle = $entity->bundle();

  if (!in_array($bundle, ['publicacao', 'publicacao_cientifica', 'projeto_pesquisa_extensao', 'evento_cientifico'], TRUE)) {
    return;
  }

  $original = $entity->original ?? NULL;
  if (!$original) {
    return;
  }

  $changed = FALSE;

  if ($entity->getTitle() !== $original->getTitle()) {
    $changed = TRUE;
  }
  if ($entity->hasField('field_territorio') && $entity->get('field_territorio')->getString() !== $original->get('field_territorio')->getString()) {
    $changed = TRUE;
  }
  if ($entity->hasField('field_ods') && $entity->get('field_ods')->getString() !== $original->get('field_ods')->getString()) {
    $changed = TRUE;
  }
  if ($entity->getPublished() !== $original->getPublished()) {
    $changed = TRUE;
  }

  if ($changed) {
    \Drupal::queue('neruds_google_sync')->createItem([
      'action' => 'update',
      'entity_type' => $entity->getEntityTypeId(),
      'entity_id' => $entity->id(),
      'bundle' => $bundle,
      'timestamp' => \Drupal::time()->getRequestTime(),
    ]);

    \Drupal::logger('neruds_google_integration')
      ->info('Queued sync for updated @bundle @id', ['@bundle' => $bundle, '@id' => $entity->id()]);
  }
}

/**
 * Implements hook_entity_delete().
 */
function neruds_google_integration_entity_delete(\Drupal\Core\Entity\EntityInterface $entity): void {
  if (!$entity instanceof \Drupal\node\NodeInterface) {
    return;
  }

  $bundle = $entity->bundle();

  if (!in_array($bundle, ['publicacao', 'publicacao_cientifica', 'projeto_pesquisa_extensao', 'evento_cientifico'], TRUE)) {
    return;
  }

  \Drupal::queue('neruds_google_sync')->createItem([
    'action' => 'delete',
    'entity_type' => $entity->getEntityTypeId(),
    'entity_id' => $entity->id(),
    'bundle' => $bundle,
    'timestamp' => \Drupal::time()->getRequestTime(),
  ]);
}

/**
 * Implements hook_cron().
 */
function neruds_google_integration_cron(): void {
  $queue = \Drupal::queue('neruds_google_sync');

  for ($i = 0; $i < 100; $i++) {
    $item = $queue->claimItem();
    if (!$item) {
      break;
    }

    try {
      $queue_worker = \Drupal::service('plugin.manager.queue_worker')
        ->createInstance('neruds_google_sync');
      $queue_worker->processItem($item->data);
      $queue->deleteItem($item);
    }
    catch (\Exception $e) {
      \Drupal::logger('neruds_google_integration')
        ->error('Sync failed: @error', ['@error' => $e->getMessage()]);
      $queue->releaseItem($item);
    }
  }

  $lastSync = \Drupal::state()->get('neruds_google_sync.last_full_sync', 0);
  $now = \Drupal::time()->getRequestTime();

  if ($now - $lastSync > 86400) {
    \Drupal::logger('neruds_google_integration')->info('Running full daily sync...');

    $nids = \Drupal::entityQuery('node')
      ->condition('status', 1)
      ->condition('type', ['publicacao', 'publicacao_cientifica'], 'IN')
      ->execute();

    foreach ($nids as $nid) {
      \Drupal::queue('neruds_google_sync')->createItem([
        'action' => 'update',
        'entity_type' => 'node',
        'entity_id' => $nid,
        'bundle' => 'publicacao',
        'timestamp' => $now,
      ]);
    }

    \Drupal::state()->set('neruds_google_sync.last_full_sync', $now);
  }
}
